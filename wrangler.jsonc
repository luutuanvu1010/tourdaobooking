{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tourdao-sales",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Tên miền chính thức (chủ dự án chốt 2026-09-19, thay trang fastbooking); đã deploy và chạy thật từ 2026-09-19. Deploy tự tạo bản ghi DNS và báo lỗi nếu hostname còn thuộc thứ khác. Khi khai `routes` mà không khai `workers_dev`, wrangler TẮT địa chỉ workers.dev và preview URL của Worker này (đã xảy ra ở lần deploy đầu: workers.dev trả 404). Muốn bật lại làm dự phòng thì thêm `"workers_dev": true`; hiện cố ý để tắt để chỉ có một địa chỉ vào app.
  "routes": [{ "pattern": "booking.tourdao.vn", "custom_domain": true }],
  // Tự đồng bộ danh mục dịch vụ từ Google Sheet mỗi 15 phút (ngoài nút "Đồng bộ ngay" của Admin).
  "triggers": { "crons": ["*/15 * * * *"] },
  // ID Google Sheet (không phải bí mật; Sheet chỉ được ĐỌC công khai). Xem spec §2.4-6.
  "vars": {
    "STAFF_SHEET_ID": "16K3b1CtqjJqXR_CkfSSdLyK0t6j0pYq_OuskF0VFaw4",
    "SERVICES_SHEET_ID": "1XPx1g0JVTdevdX35MeCpt6Cc6Dgxdmfer6okEWleD3s",
    // Đăng nhập bằng Face ID (passkey, ADR-0016): KHÔNG dùng tourdao.vn (website công khai là Worker khác).
    "PASSKEY_RP_ID": "booking.tourdao.vn",
    "PASSKEY_ORIGIN": "https://booking.tourdao.vn"
  },
  // UI tĩnh (public/) phục vụ qua Workers Assets; /api/* luôn vào Worker trước. JS trong public/js do `npm run build:web` sinh từ web/.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "build": { "command": "npm run build:web", "watch_dir": "web" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tourdao-sales-db",
      "database_id": "bcd4c0ac-7c97-4129-886f-380daecd58fc",
      "migrations_dir": "migrations"
    }
  ],
  // Email Service (beta, gói Workers Paid): binding EMAIL theo developers.cloudflare.com/email-service (khoá `send_email`). KHÔNG khai `remote`: tài liệu nói `wrangler dev` không dùng remote binding thì chạy bộ mô phỏng cục bộ (không cần đăng nhập/mạng), nên `npm run dev` và e2e chạy offline được. Muốn thử gửi thư thật khi dev thì tạm đổi thành { "name": "EMAIL", "remote": true } (cần đăng nhập Cloudflare), đừng commit. Thiếu binding hoặc thiếu hai secret FEEDBACK_NOTIFY_EMAIL / FEEDBACK_MAIL_FROM thì email tự tắt; yêu cầu Góp ý vẫn lưu và hàng đợi báo "chưa gửi được email". Nếu `wrangler deploy` báo lỗi vì binding này (chưa bật Email Service/chưa xác minh tên miền — CHƯA kiểm chứng), gỡ khối `send_email` rồi deploy lại.
  "send_email": [{ "name": "EMAIL" }],
  // BẢNG TIN (ADR-0022): trạm WebSocket = Durable Object `BangTin` (src/modules/bangtin/tram.ts, export từ src/index.ts). MỘT trạm duy nhất tên "cong-ty"
  // cho cả công ty (vài chục nhân viên + đối tác: một trạm đủ sức, không cần chia nhỏ, và phát tin chỉ cần hỏi một nơi). Lưu trữ SQLite theo khuyến nghị
  // Cloudflare, nhưng trạm KHÔNG lưu dữ liệu nào ngoài một báo thức (không tin, không bảng).
  // Lưu ý vận hành: (1) MỖI lần deploy ngắt MỌI kết nối đang mở (Cloudflare khởi động lại Durable Object) — trình duyệt tự nối lại trong vài giây.
  // (2) Sau khi deploy bản có migration "v1" này, Cloudflare CHẶN `wrangler rollback` về mọi bản trước nó (thay đổi vòng đời lớp Durable Object).
  //     Muốn lùi thì deploy một bản mới GỠ route/bộ nghe phía trình duyệt nhưng GIỮ lớp + binding + migration này — không xoá khối dưới đây.
  // Không khai BANG_TIN_HAN_GIAY trong `vars`: production dùng mặc định 900 giây; biến đó chỉ để e2e rút ngắn (`--var`).
  "durable_objects": { "bindings": [{ "name": "BANG_TIN", "class_name": "BangTin" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BangTin"] }]
}
