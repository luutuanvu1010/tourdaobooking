{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/action/**",
              "components/chrome/**",
              "components/content/**",
              "components/feedback/**",
              "components/home/**",
              "components/layout/**",
              "components/listing/**",
              "components/map/**",
              "components/templates/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito|Be Vietnam Pro))/i]",
        "message": "Font not provided by the design system. Available: Nunito, Be Vietnam Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleData'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|image|gallery|badges|crumbs|infoRows|blocks|faq|updatedAt|sameAsHref|sameAsLabel|author|approvedBy|contentProvenance|key|ref|className|style|children)$/]",
        "message": "<ArticleData> doesn't accept that prop. Declared props: title, summary, image, gallery, badges, crumbs, infoRows, blocks, faq, updatedAt, sameAsHref, sameAsLabel, author, approvedBy, contentProvenance."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleData'] > JSXAttribute[name.name='contentProvenance'] > Literal[value!=/^(?:human|ai-t1|mixed)$/]",
        "message": "<ArticleData> contentProvenance must be one of 'human' | 'ai-t1' | 'mixed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttractionData'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|image|gallery|badges|facts|crumbs|priceText|priceLabel|isFree|asOf|ctaHref|ctaLabel|overview|highlights|tips|faq|images|geo|updatedAt|sameAsHref|sameAsLabel|key|ref|className|style|children)$/]",
        "message": "<AttractionData> doesn't accept that prop. Declared props: title, summary, image, gallery, badges, facts, crumbs, priceText, priceLabel, isFree, asOf, ctaHref, ctaLabel, overview, highlights, tips, faq, images, geo, updatedAt, sameAsHref, sameAsLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorityMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:approvedBy|contentProvenance|officialSource|sameAs|author|key|ref|className|style|children)$/]",
        "message": "<AuthorityMeta> doesn't accept that prop. Declared props: approvedBy, contentProvenance, officialSource, sameAs, author."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorityMeta'] > JSXAttribute[name.name='contentProvenance'] > Literal[value!=/^(?:human|ai-t1|mixed)$/]",
        "message": "<AuthorityMeta> contentProvenance must be one of 'human' | 'ai-t1' | 'mixed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|style|text|src|alt|key|ref|className|style|children)$/]",
        "message": "<BodyBlock> doesn't accept that prop. Declared props: type, style, text, src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyBlock'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:block|image)$/]",
        "message": "<BodyBlock> type must be one of 'block' | 'image'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyBlock'] > JSXAttribute[name.name='style'] > Literal[value!=/^(?:normal|h2|h3|h4)$/]",
        "message": "<BodyBlock> style must be one of 'normal' | 'h2' | 'h3' | 'h4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:priceText|ctaUrl|ctaLabel|asOf|key|ref|className|style|children)$/]",
        "message": "<BookingCTA> doesn't accept that prop. Declared props: priceText, ctaUrl, ctaLabel, asOf."
