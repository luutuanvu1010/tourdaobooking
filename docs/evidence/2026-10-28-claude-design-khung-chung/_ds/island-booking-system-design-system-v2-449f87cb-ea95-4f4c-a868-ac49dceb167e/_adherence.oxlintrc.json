        "patterns": [
          {
            "group": [
              "components/dieu-huong/cum-tim-loc/**",
              "components/dieu-huong/dau-trang/**",
              "components/dieu-huong/phan-trang/**",
              "components/dieu-huong/thanh-ben/**",
              "components/dieu-huong/thanh-dinh-day/**",
              "components/dieu-huong/thanh-tab-duoi/**",
              "components/dieu-huong/thanh-tren/**",
              "components/hanh-dong/chip/**",
              "components/hanh-dong/nut/**",
              "components/hanh-dong/tab/**",
              "components/hien-thi/bang-du-lieu/**",
              "components/hien-thi/bieu-tuong/**",
              "components/hien-thi/dong-danh-sach/**",
              "components/hien-thi/huy-hieu/**",
              "components/hien-thi/khung-xuong/**",
              "components/hien-thi/the/**",
              "components/nhap/bo-dem/**",
              "components/nhap/o-chon/**",
              "components/nhap/o-nhap/**",
              "components/phan-hoi/bang-truot/**",
              "components/phan-hoi/bao-xong/**",
              "components/phan-hoi/dai-thong-bao/**",
              "components/phan-hoi/dai-tren-trang/**",
              "components/phan-hoi/hop-xac-nhan/**",
              "components/phan-hoi/trang-rong/**",
              "components/trang/trang-loi/**",
              "components/trang/trang-mat-mang/**",
              "guidelines/trang/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Be Vietnam Pro|Nunito|Lexend|Noto Sans))/i]",
        "message": "Font not provided by the design system. Available: Be Vietnam Pro, Nunito, Lexend, Noto Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cot'] > JSXAttribute > JSXIdentifier[name!=/^(?:khoa|nhan|can|gon|rong|hien|key|ref|className|style|children)$/]",
        "message": "<Cot> doesn't accept that prop. Declared props: khoa, nhan, can, gon, rong, hien."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cot'] > JSXAttribute[name.name='can'] > Literal[value!=/^(?:trai|phai)$/]",
        "message": "<Cot> can must be one of 'trai' | 'phai'."
      },
