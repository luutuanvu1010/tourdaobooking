{
  "name": "tourdao-sales",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:migrate:local": "wrangler d1 migrations apply tourdao-sales-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tourdao-sales-db --remote",
    "build:web": "esbuild web/login.ts web/orders.ts web/order-form.ts web/order.ts web/audit.ts web/staff.ts web/account.ts web/catalog.ts --bundle --format=esm --target=es2022 --minify --outdir=public/js",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  }
}
