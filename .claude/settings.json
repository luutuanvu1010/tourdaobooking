{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)",
      "Bash(wrangler rollback *)",
      "Bash(npx wrangler rollback *)",
      "Bash(npm run db:migrate:remote)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Edit(src/CLAUDE.md)",
      "Edit(web/CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(playbook/**)",
      "Edit(docs/adr/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-remote.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
