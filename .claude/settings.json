{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)",
      "Bash(wrangler rollback *)",
      "Bash(npx wrangler rollback *)",
      "Bash(npm run db:migrate:remote)",
      "Bash(npm run day-len)",
      "Bash(npm run day-len *)",
      "Bash(npm run trien-khai)",
      "Bash(npm run trien-khai *)",
      "Bash(node scripts/day-len.mjs)",
      "Bash(node scripts/day-len.mjs *)",
      "Bash(node scripts/trien-khai.mjs)",
      "Bash(node scripts/trien-khai.mjs *)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Edit(src/CLAUDE.md)",
      "Edit(web/CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(playbook/**)",
      "Edit(docs/adr/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-remote.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tep.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
